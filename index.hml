<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MCKOKOS.PRO - Minecraft Server</title>
  
  <!-- Google Fonts pro moderní vzhled -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    /* Reset & základní nastavení */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: #0d0f12;
      color: #ffffff;
      line-height: 1.6;
    }

    /* 1. Horní navigace */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(15, 17, 23, 0.75);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
    }

    .nav-logo {
      font-weight: 800;
      font-size: 1.2rem;
      letter-spacing: 1px;
      color: #ff4757;
    }

    .nav-links {
      display: flex;
      gap: 25px;
    }

    .nav-links a {
      color: #d1d8e0;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: #ff4757;
    }

    /* 2. Hero banner s pozadím */
    .hero {
      position: relative;
      min-height: 70vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 100px 20px 40px;

      /* ZDE MŮŽEŠ ZMĚNIT ODKAZ NA OBRÁZEK POZADÍ */
      background: linear-gradient(to bottom, rgba(13, 15, 18, 0.4), rgba(13, 15, 18, 1)),
                  url('https://images.unsplash.com/photo-1627856013091-fed6e4e30025?q=80&w=1920&auto=format&fit=crop') center/cover no-repeat;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    /* Název/Logo serveru */
    .main-logo {
      font-size: 4.5rem;
      font-weight: 800;
      color: #ff4757;
      text-transform: uppercase;
      letter-spacing: 3px;
      text-shadow: 0 5px 25px rgba(255, 71, 87, 0.5),
                   0 2px 0px #b33939;
    }

    /* IP Box pod logem */
    .ip-box {
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 10px 25px;
      border-radius: 30px;
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.95rem;
    }

    .ip-text {
      color: #a4b0be;
    }

    .divider {
      color: rgba(255, 255, 255, 0.2);
    }

    /* 3. Mřížka se 4 kartami */
    .content-container {
      max-width: 1200px;
      margin: -40px auto 60px;
      padding: 0 20px;
      position: relative;
      z-index: 10;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
    }

    /* Karta + Efekt zvětšení při najetí (Hover) */
    .card {
      background: rgba(22, 26, 33, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 30px 25px;
      backdrop-filter: blur(10px);
      
      /* Plynulý přechod pro zvětšení */
      transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), 
                  box-shadow 0.3s ease, 
                  border-color 0.3s ease;
      cursor: pointer;
    }

    /* Zvětšení karty na hover */
    .card:hover {
      transform: translateY(-8px) scale(1.03);
      border-color: rgba(255, 71, 87, 0.4);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5), 
                  0 0 20px rgba(255, 71, 87, 0.2);
    }

    .card-icon {
      font-size: 2.2rem;
      margin-bottom: 15px;
    }

    .card h2 {
      font-size: 1.3rem;
      margin-bottom: 12px;
      color: #ffffff;
    }

    .card p {
      color: #a4b0be;
      font-size: 0.92rem;
    }

    .card code {
      background: rgba(255, 71, 87, 0.15);
      color: #ff4757;
      padding: 2px 6px;
      border-radius: 4px;
      font-weight: 600;
    }

    .social-list {
      list-style: none;
      margin-top: 10px;
    }

    .social-list li {
      margin-bottom: 6px;
    }

    .social-list a {
      color: #ff4757;
      text-decoration: none;
      font-weight: 600;
      transition: opacity 0.2s;
    }

    .social-list a:hover {
      opacity: 0.8;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 30px 20px;
      color: #57606f;
      font-size: 0.85rem;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Responsivita pro mobily */
    @media (max-width: 768px) {
      .main-logo {
        font-size: 3rem;
      }
      
      .cards-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Horní navigační lišta -->
  <header class="navbar">
    <div class="nav-container">
      <div class="nav-logo">MCKOKOS.PRO</div>
      <nav class="nav-links">
        <a href="#" class="active">Domů</a>
        <a href="#">Tým</a>
        <a href="#">Pravidla</a>
      </nav>
    </div>
  </header>

  <!-- Hero sekce (Banner s pozadím a velkým logem) -->
  <section class="hero">
    <div class="hero-content">
      <!-- Velké logo -->
      <h1 class="main-logo">MCKOKOS</h1>
      
      <!-- Status bar s IP adresou -->
      <div class="ip-box">
        <span class="status-icon">🎮</span>
        <span class="player-count"><strong>0</strong> / 500 hráčů online</span>
        <span class="divider">|</span>
        <span class="ip-text">mckokos.pro</span>
      </div>
    </div>
  </section>

  <!-- Sekce se 4 kartami pod logem -->
  <main class="content-container">
    <div class="cards-grid">

      <!-- Karta 1: Info o serveru -->
      <div class="card">
        <div class="card-icon">ℹ️</div>
        <h2>Info o serveru</h2>
        <p>Vítej na Minecraft serveru <strong>mckokos.pro</strong>! Nabízíme skvělý komunitní zážitek, stabilní chod bez lagů a spoustu unikátních funkčních prvků pro všechny hráče.</p>
      </div>

      <!-- Karta 2: Sociální sítě -->
      <div class="card">
        <div class="card-icon">🌐</div>
        <h2>Sociální sítě</h2>
        <p>Sleduj nás a buď v obraze ohledně všech novinek a soutěží!</p>
        <ul class="social-list">
          <li><a href="#">Discord Komunita</a></li>
          <li><a href="#">Instagram @mckokos</a></li>
          <li><a href="#">TikTok Videa</a></li>
        </ul>
      </div>

      <!-- Karta 3: O serveru -->
      <div class="card">
        <div class="card-icon">⚔️</div>
        <h2>Něco o serveru</h2>
        <p>U nás najdeš propracovaný Survival, pravidelné eventy o hodnotné odměny a přátelský Admin Team, který ti rád pomůže s jakýmkoliv dotazem.</p>
      </div>

      <!-- Karta 4: Jak se připojit -->
      <div class="card">
        <div class="card-icon">🚀</div>
        <h2>Jak se připojit</h2>
        <p>1. Zapni Minecraft (verze 1.20+)</p>
        <p>2. Jdi do <em>Více hráčů (Multiplayer)</em></p>
        <p>3. Přidej server s adresou: <code>mckokos.pro</code></p>
      </div>

    </div>
  </main>

  <footer>
    <p>&copy; 2026 mckokos.pro — Všechna práva vyhrazena.</p>
  </footer>

</body>
</html>
