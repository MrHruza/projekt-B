<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MCKOKOS.PRO - Minecraft Server</title>
  <!-- Google Fonts pro moderní font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Horní navigační lišta -->
  <header class="navbar">
    <div class="nav-container">
      <div class="nav-logo">MCKOKOS.PRO</div>
      <nav class="nav-links">
        <a href="#" class="active">Domů</a>
        <a href="#">Tým</a>
        <a href="#">Pravidla</a>
      </nav>
    </div>
  </header>

  <!-- Hero sekce (Banner s pozadím a velkým logem) -->
  <section class="hero">
    <div class="hero-content">
      <!-- Velké logo (zatím textové s efektem, nahraď např. <img src="logo.png">) -->
      <h1 class="main-logo">MCKOKOS</h1>
      
      <!-- Status bar s IP adresou -->
      <div class="ip-box">
        <span class="status-icon">🎮</span>
        <span class="player-count"><strong>0</strong> / 500 hráčů online</span>
        <span class="divider">|</span>
        <span class="ip-text">mckokos.pro</span>
      </div>
    </div>
  </section>

  <!-- Sekce se 4 kartami pod logem -->
  <main class="content-container">
    <div class="cards-grid">

      <!-- Karta 1: Info o serveru -->
      <div class="card">
        <div class="card-icon">ℹ️</div>
        <h2>Info o serveru</h2>
        <p>Vítej na Minecraft serveru <strong>mckokos.pro</strong>! Nabízíme skvělý komunitní zážitek, stabilní chod bez lagů a spoustu unikátních funkcí pro všechny hráče.</p>
      </div>

      <!-- Karta 2: Sociální sítě -->
      <div class="card">
        <div class="card-icon">🌐</div>
        <h2>Sociální sítě</h2>
        <p>Sleduj nás a buď v obraze ohledně všech novinek a soutěží!</p>
        <ul class="social-list">
          <li><a href="#">Discord Komunita</a></li>
          <li><a href="#">Instagram @mckokos</a></li>
          <li><a href="#">TikTok Videa</a></li>
        </ul>
      </div>

      <!-- Karta 3: O serveru -->
      <div class="card">
        <div class="card-icon">⚔️</div>
        <h2>Něco o serveru</h2>
        <p>U nás najdeš propracovaný Survival, pravidelné eventy o hodnotné odměny a přátelský Admin Team, který ti rád pomůže s jakýmkoliv problémem.</p>
      </div>

      <!-- Karta 4: Jak se připojit -->
      <div class="card">
        <div class="card-icon">🚀</div>
        <h2>Jak se připojit</h2>
        <p>1. Zapni Minecraft (verze 1.20+)</p>
        <p>2. Jdi do <em>Multiplayer (Hra jednoho hráče / Více hráčů)</em></p>
        <p>3. Přidej server s adresou: <code>mckokos.pro</code></p>
      </div>

    </div>
  </main>

  <footer>
    <p>&copy; 2026 mckokos.pro — Všechna práva vyhrazena.</p>
  </footer>

</body>
</html>
